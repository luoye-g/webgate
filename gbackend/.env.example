
# server database config
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASS=
# redis config
REDIS_HOST=
REDIS_PORT=
REDIS_PASS=
# log config
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info
# LOG_FORMAT: json | text
LOG_FORMAT=json
# LOG_DIR: directory for log files. Empty means console only.
LOG_DIR=./log
# LOG_FILE: base file name; final file will be "<name>-YYYY-MM-DD.log"
LOG_FILE=evet
# LOG_CONSOLE: also write to stdout (true | false)
LOG_CONSOLE=true